{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ventoreastudios.online"
        }
      ],
      "destination": "https://www.ventoreastudios.online/:path*",
      "permanent": true
    },
    {
      "source": "/studio-hub.html",
      "destination": "/studio-hub",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/studio-hub",
      "destination": "/studio-hub.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
