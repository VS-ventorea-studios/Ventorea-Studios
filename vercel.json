{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ventoreastudios.online"
        }
      ],
      "destination": "https://www.ventoreastudios.online/:path*",
      "permanent": true
    },
    {
      "source": "/studio-hub.html",
      "destination": "/studio-hub",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/studio-hub",
      "destination": "/studio-hub.html"
    }
  ]
}
